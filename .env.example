# DATA_SUPABASE_SCHEMA=core

# Expo/EAS — somente servidor (nunca VITE_*). Mapeado internamente para EXPO_TOKEN quando necessário.
# EXPO_ACCESS_TOKEN=
# EXPO_ACCOUNT=quartavia
# EXPO_PROJECT_SLUG=pharus
# Opcional se já conhecido: EXPO_PROJECT_ID=
